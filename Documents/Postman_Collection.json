          "raw": "{\n  \"customerId\": \"CUST-10028471\",\n  \"documentType\": \"PAN\",\n  \"fileName\": \"pan_invalid.pdf\",\n  \"fileContentBase64\": \"SU5WQUxJRFBBTk5VTUJFUg==\"\n}",
          "options": {
