        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"CUST-10028471\",\n  \"documentType\": \"PAN\",\n  \"fileName\": \"pan_malformed.pdf\",\n  \"fileContentBase64\": \"not-a-valid-base64!!!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/documents/upload",
        "description": "Invalid Base64 in `fileContentBase64`. Expected **400 Bad Request** (`FileContentBase64 is not valid base64.`)."
      }
    },
    {
      "name": "Fetch Workflow Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/documents/status/{{documentId}}",
        "description": "Reads the persisted workflow snapshot for `{{documentId}}`. Run any successful upload first so the collection variable is populated. Expected **200** with `status`, `message`, `extractedText`, and `updatedUtc`; **404** if the id is unknown."
      }
    }
  ]
}
