{
  "info": {
    "_postman_id": "a7c4e9d1-2b58-4f0a-9c31-6e8d5b1a4f72",
    "name": "Document Processing Orchestrator",
    "description": "Task 1007 Section 9 — KYC document upload and workflow status against DocumentProcessing.Api.\n\nImport this collection, confirm `baseUrl` (default `http://localhost:5222`), then run the upload requests. Each successful upload stores `documentId` on the collection so Fetch Workflow Status can be sent without copying the id by hand.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5222"
    },
    {
      "key": "documentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Valid PAN Upload",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "    const json = pm.response.json();",
              "    if (json && json.documentId) {",
              "        pm.collectionVariables.set('documentId', json.documentId);",
              "    }",
              "} catch (e) {",
              "    console.log('No documentId to save.');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"CUST-10028471\",\n  \"documentType\": \"PAN\",\n  \"fileName\": \"pan_valid.pdf\",\n  \"fileContentBase64\": \"QUJDREUxMjM0Rg==\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/documents/upload",
        "description": "Happy-path PAN. Decoded payload is `ABCDE1234F` (five letters, four digits, one letter). Expected **200** with `status`: `APPROVED`."
      }
    },
    {
